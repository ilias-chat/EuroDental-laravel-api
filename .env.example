APP_NAME=EuroDentalAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

L5_SWAGGER_API_TITLE="EuroDental CRM and Webshop API"
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_DARK_MODE=false
L5_SWAGGER_CONST_HOST=http://127.0.0.1:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eurodental
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=array
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=media

# Local media service defaults. In production, set both URLs to:
# https://media.eurodental.ma
MEDIA_SERVICE_URL=http://127.0.0.1:8020
MEDIA_PUBLIC_URL=http://127.0.0.1:8020
MEDIA_SERVICE_TOKEN=
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8100,http://127.0.0.1:8100
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@eurodental.ma
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=contact@eurodental.ma
MAIL_FROM_NAME="EuroDental"
