#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$input = new ArgvInput;

// Quick utility: php artisan webpush:vapid
if ($input->getFirstArgument() === 'webpush:vapid') {
    try {
        $v = Minishlink\WebPush\VAPID::createVapidKeys();
        echo 'VAPID_PUBLIC_KEY=' . ($v['publicKey'] ?? ($v['public'] ?? '')) . PHP_EOL;
        echo 'VAPID_PRIVATE_KEY=' . ($v['privateKey'] ?? ($v['private'] ?? '')) . PHP_EOL;
        exit(0);
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Error generating VAPID keys: ' . $e->getMessage() . PHP_EOL);
        exit(1);
    }
}

$status = $app->handleCommand($input);

exit($status);
